# SnapTrade developer credentials (https://dashboard.snaptrade.com). Personal tier is free
# for your OWN accounts. Register one SnapTrade user, connect your brokers in the portal.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# Ghostfolio. GHOSTFOLIO_TOKEN is the Security Token shown once at account creation
# (sync.py exchanges it for a bearer JWT itself).
GHOSTFOLIO_URL=http://ghostfolio:3333
GHOSTFOLIO_TOKEN=

# Optional
SYNC_LOT_DATE=2024-01-01   # date stamped on the synthetic BUY activities
STALE_HOURS=36             # skip an account whose SnapTrade sync is older than this
